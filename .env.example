# Token Bearer OTD (obligatoire pour fetch OTD/DATEX II)
# Créez une clé sur https://opentransportdata.swiss/
OTD_BEARER_TOKEN=your_bearer_token_here

# TomTom API Keys (https://developer.tomtom.com/)
# Le cron Monaco alterne KEY_1 et KEY_2 toutes les 5 minutes.
# TOMTOM_API_KEY reste supporté (prioritaire si déjà exportée).
TOMTOM_API_KEY_1=your_tomtom_api_key_1
TOMTOM_API_KEY_2=your_tomtom_api_key_2

# Identifiant client pour les requêtes DATEX II (optionnel)
# OTD_CLIENT_ID=my_app
